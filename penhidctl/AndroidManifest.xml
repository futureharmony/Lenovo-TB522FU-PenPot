<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="410005"
    android:versionName="4.1.5"
    package="com.aclaniakea.penhidctl">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />
    <application android:theme="@style/AppTheme" android:label="联想平板 Pro GT - 手写笔系统服务" android:allowBackup="false">
        <!-- directBootAware：user 0 处于 RUNNING_LOCKED（这台 ROM 息屏会重新
             锁回用户，不只开机首次解锁前）时，PMS 只放行 DBA 组件；没有这个
             标志，`am start-foreground-service` 返回 rc=255
             ("Error: Not found; no service started")，锁屏期整条 HID 断/连
             通路结构性不可用。本服务只碰蓝牙栈（系统服务，本身 DBA），不读
             任何 CE 数据，DBA 安全。 -->
        <service android:name=".PenHidService" android:exported="true" android:stopWithTask="true" android:foregroundServiceType="shortService" android:directBootAware="true" />
    </application>
</manifest>
